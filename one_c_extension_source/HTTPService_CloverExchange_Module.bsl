        Элемент.Вставить("id", Строка(Результат.Ссылка.УникальныйИдентификатор()));
        Элемент.Вставить("code", Результат.Код);
        Элемент.Вставить("name", Результат.Наименование);
        Элементы.Добавить(Элемент);
    КонецЦикла;

    Данные = Новый Структура;
    Данные.Вставить("ok", Истина);
    Данные.Вставить("items", Элементы);
    Возврат ОтветJSON(200, Данные);
КонецФункции

Функция CreateDraftOrder(Запрос) Экспорт
    Если Не АвторизацияПройдена(Запрос) Тогда
        Возврат ОшибкаJSON(401, "Неверный ключ обмена Clover.");
    КонецЕсли;

    // Защитная блокировка версии 2.2.
    // Не удаляйте её до создания резервной копии и выбора
    // Организации, Договора, ВидаЦен и СтруктурнойЕдиницыПродажи.
    Возврат ОшибкаJSON(409,
        "Запись черновиков пока заблокирована расширением Clover 2.2. Чтение справочников разрешено.");
КонецФункции
