// Clover ↔ 1С:УНФ 1.6
// Исходный шаблон модуля HTTP-сервиса для платформы 8.3.13+.
// Версия 2.2: проверка связи и чтение справочников.
// Создание рабочего черновика намеренно заблокировано до следующей проверки.

Функция ПолучитьКлючОбмена()
    // Замените значение перед публикацией и укажите тот же ключ
    // в server/.env параметром ONEC_API_KEY.
    Возврат "CHANGE_ME_CLOVER_SECRET";
КонецФункции

Функция ОтветJSON(КодСостояния, Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();

    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(КодСостояния, ТекстОшибки)
    Данные = Новый Структура;
    Данные.Вставить("ok", Ложь);
    Данные.Вставить("error", ТекстОшибки);
    Возврат ОтветJSON(КодСостояния, Данные);
КонецФункции

Функция АвторизацияПройдена(Запрос)
    КлючОбмена = ПолучитьКлючОбмена();
    Если ПустаяСтрока(КлючОбмена) Тогда
        Возврат Ложь;
    КонецЕсли;

    КлючЗапроса = Запрос.Заголовки.Получить("X-Clover-Key");
    Возврат ЗначениеЗаполнено(КлючЗапроса) И КлючЗапроса = КлючОбмена;
КонецФункции

Функция ПолучитьЛимит(Запрос)
    Лимит = 20;
    Попытка
        ЗначениеЛимита = Запрос.ПараметрыЗапроса.Получить("limit");
        Если ЗначениеЗаполнено(ЗначениеЛимита) Тогда
            Лимит = Число(ЗначениеЛимита);
        КонецЕсли;
    Исключение
        Лимит = 20;
    КонецПопытки;

    Если Лимит < 1 Тогда Лимит = 1; КонецЕсли;
    Если Лимит > 100 Тогда Лимит = 100; КонецЕсли;
    Возврат Лимит;
КонецФункции

Функция Health(Запрос) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("ok", Истина);
    Данные.Вставить("service", "Clover HTTP service");
    Данные.Вставить("configuration", "Управление нашей фирмой 1.6");
    Данные.Вставить("platform", "8.3.13+");
    Данные.Вставить("database", "Рабочая информационная база");
    Данные.Вставить("extensionVersion", "2.2-readonly");
    Данные.Вставить("writeEnabled", Ложь);
    Возврат ОтветJSON(200, Данные);
КонецФункции

Функция Clients(Запрос) Экспорт
    Если Не АвторизацияПройдена(Запрос) Тогда
        Возврат ОшибкаJSON(401, "Неверный ключ обмена Clover.");
    КонецЕсли;

    Лимит = ПолучитьЛимит(Запрос);
    ТекстЗапроса =
    "ВЫБРАТЬ ПЕРВЫЕ 100
    |   Контрагенты.Ссылка КАК Ссылка,
    |   Контрагенты.Код КАК Код,
    |   Контрагенты.Наименование КАК Наименование
    |ИЗ
    |   Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |   НЕ Контрагенты.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |   Контрагенты.Наименование";

    Результат = Новый Запрос(ТекстЗапроса).Выполнить().Выбрать();
    Элементы = Новый Массив;

    Пока Результат.Следующий() И Элементы.Количество() < Лимит Цикл
        Элемент = Новый Структура;
        Элемент.Вставить("id", Строка(Результат.Ссылка.УникальныйИдентификатор()));
        Элемент.Вставить("code", Результат.Код);
        Элемент.Вставить("name", Результат.Наименование);
        Элементы.Добавить(Элемент);
    КонецЦикла;

    Данные = Новый Структура;
    Данные.Вставить("ok", Истина);
    Данные.Вставить("items", Элементы);
    Возврат ОтветJSON(200, Данные);
КонецФункции

Функция Products(Запрос) Экспорт
    Если Не АвторизацияПройдена(Запрос) Тогда
        Возврат ОшибкаJSON(401, "Неверный ключ обмена Clover.");
    КонецЕсли;

    Лимит = ПолучитьЛимит(Запрос);
    ТекстЗапроса =
    "ВЫБРАТЬ ПЕРВЫЕ 100
    |   Номенклатура.Ссылка КАК Ссылка,
    |   Номенклатура.Код КАК Код,
    |   Номенклатура.Наименование КАК Наименование
    |ИЗ
    |   Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |   НЕ Номенклатура.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |   Номенклатура.Наименование";

    Результат = Новый Запрос(ТекстЗапроса).Выполнить().Выбрать();
    Элементы = Новый Массив;

    Пока Результат.Следующий() И Элементы.Количество() < Лимит Цикл
