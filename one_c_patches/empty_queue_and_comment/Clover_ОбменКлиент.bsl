Функция ПроверитьСвязь(АдресСервера, ПортСервера, ПутьПроверки) Экспорт

	Попытка
		Соединение = Новый HTTPСоединение(АдресСервера, ПортСервера);
		Запрос = Новый HTTPЗапрос(ПутьПроверки);
		Ответ = Соединение.Получить(Запрос);

		Возврат Ответ.КодСостояния;
	Исключение
		Возврат -1;
	КонецПопытки;

КонецФункции
Функция ОтправитьТоварыПредпросмотр() Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";

	ЗапросДанных = Новый Запрос(ТекстЗапроса);
	Выборка = ЗапросДанных.Выполнить().Выбрать();

	Элементы = Новый Массив;

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Элемент.Вставить("code", Выборка.Код);
		Элемент.Вставить("name", Выборка.Наименование);
		Элементы.Добавить(Элемент);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("items", Элементы);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТелоJSON = ЗаписьJSON.Закрыть();

	Попытка
		Соединение = Новый HTTPСоединение("192.168.1.47", 4100);
		ЗапросHTTP = Новый HTTPЗапрос("/api/one-c/products-preview");
		ЗапросHTTP.Заголовки.Вставить(
			"Content-Type",
			"application/json; charset=utf-8");
		ДобавитьЗаголовкиОбмена(ЗапросHTTP);
		ЗапросHTTP.УстановитьТелоИзСтроки(
			ТелоJSON,
			КодировкаТекста.UTF8);

		Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);

		Результат = Новый Структура;
		Результат.Вставить("КодСостояния", Ответ.КодСостояния);
		Результат.Вставить("Количество", Элементы.Количество());
		Возврат Результат;

	Исключение
		Результат = Новый Структура;
		Результат.Вставить("КодСостояния", -1);
		Результат.Вставить("Количество", 0);
		Возврат Результат;
	КонецПопытки;

КонецФункции
Функция НовыйРезультатЦены() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Цена", 0);
	Результат.Вставить("Источник", "");
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Оценка", -1000);
	Возврат Результат;
КонецФункции

Функция ОценитьИсточникЦены(ТекстИсточника) Экспорт
	Текст = НРег(Строка(ТекстИсточника));
	Оценка = 0;

	Если Найти(Текст, "закуп") > 0 Тогда
		Оценка = Оценка + 100;
	КонецЕсли;
	Если Найти(Текст, "постав") > 0 Тогда
		Оценка = Оценка + 80;
	КонецЕсли;
	Если Найти(Текст, "контрагент") > 0 Тогда
		Оценка = Оценка + 50;
	КонецЕсли;
	Если Найти(Текст, "себесто") > 0 Тогда
		Оценка = Оценка + 40;
	КонецЕсли;
	Если Найти(Текст, "цен") > 0 Тогда
		Оценка = Оценка + 10;
	КонецЕсли;

	Если Найти(Текст, "рознич") > 0 Тогда
		Оценка = Оценка - 120;
	КонецЕсли;
	Если Найти(Текст, "оптов") > 0 Тогда
		Оценка = Оценка - 100;
	КонецЕсли;
	Если Найти(Текст, "продаж") > 0 Тогда
		Оценка = Оценка - 100;
	КонецЕсли;

	Возврат Оценка;
КонецФункции

Функция ПолучитьЦенуИзПоследнегоПоступления(Номенклатура) Экспорт
	Результат = НовыйРезультатЦены();

	Попытка
		ЗапросЦены = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запасы.Цена КАК Цена,
		|	Запасы.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.ПриходнаяНакладная.Запасы КАК Запасы
		|ГДЕ
		|	Запасы.Ссылка.Проведен
		|	И Запасы.Номенклатура = &Номенклатура
		|	И Запасы.Цена > 0
		|УПОРЯДОЧИТЬ ПО
		|	Запасы.Ссылка.Дата УБЫВ");

		ЗапросЦены.УстановитьПараметр("Номенклатура", Номенклатура);
		ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();

		Если ВыборкаЦены.Следующий() И ВыборкаЦены.Цена > 0 Тогда
			Результат.Успех = Истина;
			Результат.Цена = ВыборкаЦены.Цена;
			Результат.Источник = "Последняя приходная накладная";
			Результат.Оценка = 70;
			Возврат Результат;
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Попытка
		ЗапросЦены = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запасы.Сумма / Запасы.Количество КАК Цена,
		|	Запасы.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.ПриходнаяНакладная.Запасы КАК Запасы
		|ГДЕ
		|	Запасы.Ссылка.Проведен
		|	И Запасы.Номенклатура = &Номенклатура
		|	И Запасы.Количество > 0
		|	И Запасы.Сумма > 0
		|УПОРЯДОЧИТЬ ПО
		|	Запасы.Ссылка.Дата УБЫВ");

		ЗапросЦены.УстановитьПараметр("Номенклатура", Номенклатура);
		ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();

		Если ВыборкаЦены.Следующий() И ВыборкаЦены.Цена > 0 Тогда
			Результат.Успех = Истина;
			Результат.Цена = ВыборкаЦены.Цена;
			Результат.Источник = "Последняя приходная накладная (сумма / количество)";
			Результат.Оценка = 65;
			Возврат Результат;
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Результат.Ошибка = "В проведённых приходных накладных цена не найдена.";
	Возврат Результат;
КонецФункции

Функция НайтиЦенуВРегистре(
	ИмяРегистра,
	ИмяПоляНоменклатуры,
	ИмяПоляЦены,
	ИмяПоляВидаЦен,
	Номенклатура,
	ОценкаРегистра,
	ИспользоватьПериод) Экспорт

	Результат = НовыйРезультатЦены();

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 50 "
		+ "Регистр." + ИмяПоляЦены + " КАК Цена";

	Если ИмяПоляВидаЦен <> "" Тогда
		ТекстЗапроса = ТекстЗапроса
			+ ", Регистр." + ИмяПоляВидаЦен + " КАК ВидЦены";
	КонецЕсли;

	Если ИспользоватьПериод Тогда
		ТекстЗапроса = ТекстЗапроса + ", Регистр.Период КАК ДатаЦены";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса
		+ " ИЗ РегистрСведений." + ИмяРегистра + " КАК Регистр"
		+ " ГДЕ Регистр." + ИмяПоляНоменклатуры + " = &Номенклатура"
		+ " И Регистр." + ИмяПоляЦены + " > 0";

	Если ИспользоватьПериод Тогда
		ТекстЗапроса = ТекстЗапроса
			+ " УПОРЯДОЧИТЬ ПО Регистр.Период УБЫВ";
	КонецЕсли;

	ЗапросЦены = Новый Запрос(ТекстЗапроса);
	ЗапросЦены.УстановитьПараметр("Номенклатура", Номенклатура);
	ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();

	Пока ВыборкаЦены.Следующий() Цикл
		ТекстВидаЦен = "";
		Если ИмяПоляВидаЦен <> "" Тогда
			ТекстВидаЦен = Строка(ВыборкаЦены.ВидЦены);
		КонецЕсли;

		Оценка = ОценкаРегистра + ОценитьИсточникЦены(ТекстВидаЦен);
		Если ВыборкаЦены.Цена > 0
			И Оценка > Результат.Оценка
			И Оценка >= 20 Тогда

			Результат.Успех = Истина;
			Результат.Цена = ВыборкаЦены.Цена;
			Результат.Источник = ИмяРегистра;

			Если ТекстВидаЦен <> "" Тогда
				Результат.Источник = Результат.Источник
					+ " / " + ТекстВидаЦен;
			КонецЕсли;

			Результат.Оценка = Оценка;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ПолучитьЦенуИзРегистров(Номенклатура) Экспорт
	ЛучшийРезультат = НовыйРезультатЦены();

	Для Каждого МетаРегистр Из Метаданные.РегистрыСведений Цикл
		ТекстРегистра = НРег(
			МетаРегистр.Имя + " " + Строка(МетаРегистр.Синоним));

		ОценкаРегистра = ОценитьИсточникЦены(ТекстРегистра);
		Если ОценкаРегистра < 10 Тогда
			Продолжить;
		КонецЕсли;

		ИмяПоляНоменклатуры = "";
		ИмяПоляВидаЦен = "";
		ИмяПоляЦены = "";
		ЛучшаяОценкаПоляЦены = -1;

		Для Каждого МетаПоле Из МетаРегистр.Измерения Цикл
			ТекстПоля = НРег(
				МетаПоле.Имя + " " + Строка(МетаПоле.Синоним));

			Если ИмяПоляНоменклатуры = ""
				И Найти(ТекстПоля, "номенклатур") > 0
				И Найти(ТекстПоля, "поставщик") = 0 Тогда

				ИмяПоляНоменклатуры = МетаПоле.Имя;
			КонецЕсли;

			Если ИмяПоляВидаЦен = ""
				И (Найти(ТекстПоля, "вид цен") > 0
					ИЛИ Найти(ТекстПоля, "видцен") > 0
					ИЛИ Найти(ТекстПоля, "тип цен") > 0
					ИЛИ Найти(ТекстПоля, "типцен") > 0) Тогда

				ИмяПоляВидаЦен = МетаПоле.Имя;
			КонецЕсли;
		КонецЦикла;

		Для Каждого МетаПоле Из МетаРегистр.Ресурсы Цикл
			ТекстПоля = НРег(
				МетаПоле.Имя + " " + Строка(МетаПоле.Синоним));

			ОценкаПоляЦены = -1;
			Если НРег(МетаПоле.Имя) = "цена" Тогда
				ОценкаПоляЦены = 100;
			ИначеЕсли Найти(ТекстПоля, "закуп") > 0
				И Найти(ТекстПоля, "цен") > 0 Тогда

				ОценкаПоляЦены = 90;
			ИначеЕсли Найти(ТекстПоля, "постав") > 0
				И Найти(ТекстПоля, "цен") > 0 Тогда

				ОценкаПоляЦены = 80;
			ИначеЕсли Найти(ТекстПоля, "цен") > 0
				И Найти(ТекстПоля, "процент") = 0
				И Найти(ТекстПоля, "валют") = 0 Тогда

				ОценкаПоляЦены = 20;
			КонецЕсли;

			Если ОценкаПоляЦены > ЛучшаяОценкаПоляЦены Тогда
				ЛучшаяОценкаПоляЦены = ОценкаПоляЦены;
				ИмяПоляЦены = МетаПоле.Имя;
			КонецЕсли;
		КонецЦикла;

		Если ИмяПоляЦены = "" Тогда
			Для Каждого МетаПоле Из МетаРегистр.Реквизиты Цикл
				ТекстПоля = НРег(
					МетаПоле.Имя + " " + Строка(МетаПоле.Синоним));

				ОценкаПоляЦены = -1;
				Если НРег(МетаПоле.Имя) = "цена" Тогда
					ОценкаПоляЦены = 100;
				ИначеЕсли Найти(ТекстПоля, "закуп") > 0
					И Найти(ТекстПоля, "цен") > 0 Тогда

					ОценкаПоляЦены = 90;
				ИначеЕсли Найти(ТекстПоля, "постав") > 0
					И Найти(ТекстПоля, "цен") > 0 Тогда

					ОценкаПоляЦены = 80;
				ИначеЕсли Найти(ТекстПоля, "цен") > 0
					И Найти(ТекстПоля, "процент") = 0
					И Найти(ТекстПоля, "валют") = 0 Тогда

					ОценкаПоляЦены = 20;
				КонецЕсли;

				Если ОценкаПоляЦены > ЛучшаяОценкаПоляЦены Тогда
					ЛучшаяОценкаПоляЦены = ОценкаПоляЦены;
					ИмяПоляЦены = МетаПоле.Имя;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если ИмяПоляНоменклатуры = "" Или ИмяПоляЦены = "" Тогда
			Продолжить;
		КонецЕсли;

		РезультатРегистра = НовыйРезультатЦены();

		Попытка
			РезультатРегистра = НайтиЦенуВРегистре(
				МетаРегистр.Имя,
				ИмяПоляНоменклатуры,
				ИмяПоляЦены,
				ИмяПоляВидаЦен,
				Номенклатура,
				ОценкаРегистра,
				Истина);
		Исключение
			Попытка
				РезультатРегистра = НайтиЦенуВРегистре(
					МетаРегистр.Имя,
					ИмяПоляНоменклатуры,
					ИмяПоляЦены,
					ИмяПоляВидаЦен,
					Номенклатура,
					ОценкаРегистра,
					Ложь);
			Исключение
				РезультатРегистра.Ошибка = ОписаниеОшибки();
			КонецПопытки;
		КонецПопытки;

		Если РезультатРегистра.Успех
			И РезультатРегистра.Оценка > ЛучшийРезультат.Оценка Тогда

			ЛучшийРезультат = РезультатРегистра;
		КонецЕсли;
	КонецЦикла;

	Возврат ЛучшийРезультат;
КонецФункции

Функция ПолучитьАктуальнуюЗакупочнуюЦену(Номенклатура) Экспорт
	РезультатРегистра = ПолучитьЦенуИзРегистров(Номенклатура);
	Если РезультатРегистра.Успех Тогда
		Возврат РезультатРегистра;
	КонецЕсли;

	РезультатПоступления =
		ПолучитьЦенуИзПоследнегоПоступления(Номенклатура);

	Если РезультатПоступления.Успех Тогда
		Возврат РезультатПоступления;
	КонецЕсли;

	Результат = НовыйРезультатЦены();
	Результат.Ошибка =
		"Не найдена закупочная цена ни в регистрах цен, "
		+ "ни в проведённых приходных накладных.";
	Возврат Результат;
КонецФункции

Функция НайтиНоменклатуруДляОбмена(Идентификатор, Код) Экспорт
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка();

	Если Строка(Идентификатор) <> "" Тогда
		Попытка
			Номенклатура =
				Справочники.Номенклатура.ПолучитьСсылку(
					Новый УникальныйИдентификатор(
						Строка(Идентификатор)));
		Исключение
			Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;

	Если Номенклатура.Пустая() И Строка(Код) <> "" Тогда
		Номенклатура =
			Справочники.Номенклатура.НайтиПоКоду(Строка(Код));
	КонецЕсли;

	Возврат Номенклатура;
КонецФункции

Функция ОбновитьЗакупочныеЦеныСледующегоЗаказа() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Количество", 0);

	Попытка
		Соединение = Новый HTTPСоединение("192.168.1.47", 4100);

		ЗапросТребований =
			Новый HTTPЗапрос(
				"/api/one-c/purchase-price-request?scope=next-order");
		ДобавитьЗаголовкиОбмена(ЗапросТребований);

		ОтветТребований = Соединение.Получить(ЗапросТребований);
		ТекстТребований =
			ОтветТребований.ПолучитьТелоКакСтроку();

		Если ОтветТребований.КодСостояния <> 200 Тогда
			ВызватьИсключение
				"Не получен запрос закупочных цен. HTTP "
				+ Строка(ОтветТребований.КодСостояния)
				+ ": " + ТекстТребований;
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстТребований);
		ДанныеТребований = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		ТребуемыеТовары = ДанныеТребований.items;
		Если ТребуемыеТовары.Количество() = 0 Тогда
			Результат.Успех = Истина;
			Возврат Результат;
		КонецЕсли;

		ЦеныДляОтправки = Новый Массив;

		Для Каждого Требование Из ТребуемыеТовары Цикл
			Номенклатура =
				НайтиНоменклатуруДляОбмена(
					Требование.id,
					Требование.code);

			Если Номенклатура.Пустая() Тогда
				ВызватьИсключение
					"В 1С не найдена номенклатура: "
					+ Строка(Требование.name)
					+ " (" + Строка(Требование.code) + ").";
			КонецЕсли;

			Цена = ПолучитьАктуальнуюЗакупочнуюЦену(Номенклатура);
			Если Не Цена.Успех Тогда
				ВызватьИсключение
					"Для товара """ + Строка(Требование.name)
					+ """ не найдена закупочная цена. "
					+ Цена.Ошибка;
			КонецЕсли;

			ЭлементЦены = Новый Структура;
			ЭлементЦены.Вставить("id", Строка(Требование.id));
			ЭлементЦены.Вставить("code", Строка(Требование.code));
			ЭлементЦены.Вставить("name", Строка(Требование.name));
			ЭлементЦены.Вставить("purchasePrice", Цена.Цена);
			ЭлементЦены.Вставить("purchasePriceUnit", "piece");
			ЭлементЦены.Вставить("purchasePriceSource", Цена.Источник);
			ЦеныДляОтправки.Добавить(ЭлементЦены);
		КонецЦикла;

		ДанныеЦен = Новый Структура;
		ДанныеЦен.Вставить("database", "TEST");
		ДанныеЦен.Вставить("items", ЦеныДляОтправки);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеЦен);
		ТелоЦен = ЗаписьJSON.Закрыть();

		ЗапросЦен = Новый HTTPЗапрос("/api/one-c/purchase-prices");
		ЗапросЦен.Заголовки.Вставить(
			"Content-Type",
			"application/json; charset=utf-8");
		ДобавитьЗаголовкиОбмена(ЗапросЦен);
		ЗапросЦен.УстановитьТелоИзСтроки(
			ТелоЦен,
			КодировкаТекста.UTF8);

		ОтветЦен = Соединение.ОтправитьДляОбработки(ЗапросЦен);
		ТекстОтветаЦен = ОтветЦен.ПолучитьТелоКакСтроку();

		Если ОтветЦен.КодСостояния <> 200 Тогда
			ВызватьИсключение
				"Clover не принял закупочные цены. HTTP "
				+ Строка(ОтветЦен.КодСостояния)
				+ ": " + ТекстОтветаЦен;
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтветаЦен);
		ДанныеОтветаЦен = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		Если ДанныеОтветаЦен.accepted
			<> ЦеныДляОтправки.Количество() Тогда

			ВызватьИсключение
				"Clover принял не все закупочные цены: "
				+ ТекстОтветаЦен;
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Количество = ЦеныДляОтправки.Количество();

	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

Функция НайтиИмяРеквизитаПоИменам(МетаОбъект, Имена) Экспорт
	Для Каждого ИмяРеквизита Из Имена Цикл
		Если МетаОбъект.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НайтиИмяРеквизитаПоКлючам(МетаОбъект, Ключи) Экспорт
	Для Каждого МетаРеквизит Из МетаОбъект.Реквизиты Цикл
		ТекстРеквизита = НРег(
			МетаРеквизит.Имя + " " + Строка(МетаРеквизит.Синоним));
		Совпало = Истина;
		Для Каждого Ключ Из Ключи Цикл
			Если Найти(ТекстРеквизита, НРег(Строка(Ключ))) = 0 Тогда
				Совпало = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Совпало Тогда
			Возврат МетаРеквизит.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура КопироватьРеквизитЕслиЕсть(Приемник, Источник, ИмяРеквизита) Экспорт
	Если Приемник.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Приемник[ИмяРеквизита] = Источник[ИмяРеквизита];
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура КопироватьРеквизитСтрокиЕслиЕсть(
	СтрокаПриемник,
	СтрокаИсточник,
	МетаСтроки,
	ИмяРеквизита) Экспорт

	Если МетаСтроки.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СтрокаПриемник[ИмяРеквизита] = СтрокаИсточник[ИмяРеквизита];
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьЗаказОбразец() Экспорт
	Попытка
		ЗапросОбразца = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Заказы.Ссылка КАК Ссылка
		|ИЗ
		| Документ.ЗаказПокупателя КАК Заказы
		|ГДЕ
		| НЕ Заказы.ПометкаУдаления
		| И Заказы.Номер ПОДОБНО &МаскаНомера
		|УПОРЯДОЧИТЬ ПО
		| Заказы.Дата УБЫВ");
		ЗапросОбразца.УстановитьПараметр("МаскаНомера", "%003266");
		ВыборкаОбразца = ЗапросОбразца.Выполнить().Выбрать();
		Если ВыборкаОбразца.Следующий() Тогда
			Возврат ВыборкаОбразца.Ссылка.ПолучитьОбъект();
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Процедура ЗаполнитьШапкуПоОбразцу(Заказ, ЗаказОбразец) Экспорт
	Имена = Новый Массив;
	Имена.Добавить("Организация");
	Имена.Добавить("СтруктурнаяЕдиница");
	Имена.Добавить("СтруктурнаяЕдиницаПродажи");
	Имена.Добавить("Склад");
	Имена.Добавить("Подразделение");
	Имена.Добавить("Состояние");
	Имена.Добавить("СостояниеЗаказа");
	Имена.Добавить("Валюта");
	Имена.Добавить("ВалютаДокумента");
	Имена.Добавить("Курс");
	Имена.Добавить("Кратность");
	Имена.Добавить("ВидЦен");
	Имена.Добавить("ТипЦен");
	Имена.Добавить("СуммаВключаетНДС");
	Имена.Добавить("НалогообложениеНДС");
	Имена.Добавить("Ответственный");
	Имена.Добавить("Менеджер");
	Имена.Добавить("СпособДоставки");
	Имена.Добавить("СпособОтгрузки");
	Имена.Добавить("ФормаОплаты");

	Для Каждого ИмяРеквизита Из Имена Цикл
		КопироватьРеквизитЕслиЕсть(Заказ, ЗаказОбразец, ИмяРеквизита);
	КонецЦикла;
КонецПроцедуры

Функция ПреобразоватьДатуClover(ЗначениеДаты) Экспорт
	ТекстДаты = СокрЛП(Строка(ЗначениеДаты));
	Если СтрДлина(ТекстДаты) < 10 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Дата(
			Число(Лев(ТекстДаты, 4)),
			Число(Сред(ТекстДаты, 6, 2)),
			Число(Сред(ТекстДаты, 9, 2)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция НайтиКонтрагентаПоДанным(ДанныеКлиента) Экспорт
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();

	Идентификатор = "";
	ЗначениеИдентификатора = Неопределено;
	ЗначениеКода = Неопределено;
	ЗначениеИмени = Неопределено;
	Если ДанныеКлиента.Свойство("id", ЗначениеИдентификатора) Тогда
		Идентификатор = СокрЛП(Строка(ЗначениеИдентификатора));
	КонецЕсли;
	Если Идентификатор <> "" Тогда
		Попытка
			Контрагент = Справочники.Контрагенты.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Идентификатор));
			Контрагент.ПолучитьОбъект();
		Исключение
			Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;

	Если Контрагент.Пустая() И ДанныеКлиента.Свойство("code", ЗначениеКода) Тогда
		КодКлиента = СокрЛП(Строка(ЗначениеКода));
		Если КодКлиента <> "" Тогда
			Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодКлиента);
		КонецЕсли;
	КонецЕсли;

	Если Контрагент.Пустая() И ДанныеКлиента.Свойство("name", ЗначениеИмени) Тогда
		ЗапросКонтрагента = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		| Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		| Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		| НЕ Контрагенты.ПометкаУдаления
		| И Контрагенты.Наименование = &Наименование");
		ЗапросКонтрагента.УстановитьПараметр(
			"Наименование", Строка(ЗначениеИмени));
		ВыборкаКонтрагента = ЗапросКонтрагента.Выполнить().Выбрать();
		Если ВыборкаКонтрагента.Следующий() Тогда
			Контрагент = ВыборкаКонтрагента.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Возврат Контрагент;
КонецФункции

Функция НайтиДоговорВКаталоге(
	ИмяСправочника,
	ИмяПоляКонтрагента,
	Контрагент,
	ТолькоОсновной) Экспорт

	Попытка
		Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1 "
			+ "Договоры.Ссылка КАК Ссылка "
			+ "ИЗ Справочник." + ИмяСправочника + " КАК Договоры "
			+ "ГДЕ НЕ Договоры.ПометкаУдаления "
			+ "И Договоры." + ИмяПоляКонтрагента + " = &Контрагент ";

		Если ТолькоОсновной Тогда
			ТекстЗапроса = ТекстЗапроса
				+ "И Договоры.Наименование ПОДОБНО &Основной ";
		КонецЕсли;

		ТекстЗапроса = ТекстЗапроса + "УПОРЯДОЧИТЬ ПО Договоры.Наименование";
		ЗапросДоговора = Новый Запрос(ТекстЗапроса);
		ЗапросДоговора.УстановитьПараметр("Контрагент", Контрагент);
		Если ТолькоОсновной Тогда
			ЗапросДоговора.УстановитьПараметр("Основной", "%Основн%");
		КонецЕсли;
		ВыборкаДоговора = ЗапросДоговора.Выполнить().Выбрать();
		Если ВыборкаДоговора.Следующий() Тогда
			Возврат ВыборкаДоговора.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция НайтиОсновнойДоговор(Контрагент, МетаРеквизитДоговора) Экспорт
	ИменаСправочников = Новый Массив;
	ТекстТипа = НРег(Строка(МетаРеквизитДоговора.Тип));
	Если Найти(ТекстТипа, "договорыконтрагентов") > 0 Тогда
		ИменаСправочников.Добавить("ДоговорыКонтрагентов");
	ИначеЕсли Найти(ТекстТипа, "договоры") > 0 Тогда
		ИменаСправочников.Добавить("Договоры");
	Иначе
		ИменаСправочников.Добавить("ДоговорыКонтрагентов");
		ИменаСправочников.Добавить("Договоры");
	КонецЕсли;

	ПоляКонтрагента = Новый Массив;
	ПоляКонтрагента.Добавить("Владелец");
	ПоляКонтрагента.Добавить("Контрагент");
	ПоляКонтрагента.Добавить("Покупатель");

	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		Для Каждого ИмяПоля Из ПоляКонтрагента Цикл
			Договор = НайтиДоговорВКаталоге(
				ИмяСправочника, ИмяПоля, Контрагент, Истина);
			Если Договор <> Неопределено Тогда
				Возврат Договор;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Функция ЕдиницаСоответствуетКоду(Единица, КодЕдиницы) Экспорт
	ТекстЕдиницы = НРег(Строка(Единица));
	Если КодЕдиницы = "pack" Тогда
		Возврат Найти(ТекстЕдиницы, "упак") > 0
			Или Найти(ТекстЕдиницы, "короб") > 0;
	ИначеЕсли КодЕдиницы = "bundle" Тогда
		Возврат Найти(ТекстЕдиницы, "пач") > 0
			Или Найти(ТекстЕдиницы, "комплект") > 0;
	КонецЕсли;

	Возврат Найти(ТекстЕдиницы, "упак") = 0
		И Найти(ТекстЕдиницы, "пач") = 0
		И Найти(ТекстЕдиницы, "короб") = 0
		И Найти(ТекстЕдиницы, "комплект") = 0;
КонецФункции

Функция ПолучитьЕдиницуИзПрошлыхЗаказов(
	Номенклатура,
	КодЕдиницы,
	ИмяПоляЕдиницы,
	ИмяПоляКоэффициента) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найдена", Ложь);
	Результат.Вставить("Единица", Неопределено);
	Результат.Вставить("Коэффициент", 1);

	Если ИмяПоляЕдиницы = "" Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 100 "
			+ "Запасы." + ИмяПоляЕдиницы + " КАК Единица";
		Если ИмяПоляКоэффициента <> "" Тогда
			ТекстЗапроса = ТекстЗапроса
				+ ", Запасы." + ИмяПоляКоэффициента + " КАК Коэффициент";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса
			+ " ИЗ Документ.ЗаказПокупателя.Запасы КАК Запасы"
			+ " ГДЕ Запасы.Номенклатура = &Номенклатура"
			+ " И НЕ Запасы.Ссылка.ПометкаУдаления"
			+ " УПОРЯДОЧИТЬ ПО Запасы.Ссылка.Дата УБЫВ";

		ЗапросЕдиниц = Новый Запрос(ТекстЗапроса);
		ЗапросЕдиниц.УстановитьПараметр("Номенклатура", Номенклатура);
		ВыборкаЕдиниц = ЗапросЕдиниц.Выполнить().Выбрать();
		Пока ВыборкаЕдиниц.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаЕдиниц.Единица)
				И ЕдиницаСоответствуетКоду(
					ВыборкаЕдиниц.Единица, КодЕдиницы) Тогда

				Результат.Найдена = Истина;
				Результат.Единица = ВыборкаЕдиниц.Единица;
				Если ИмяПоляКоэффициента <> "" Тогда
					Попытка
						Если ВыборкаЕдиниц.Коэффициент > 0 Тогда
							Результат.Коэффициент = ВыборкаЕдиниц.Коэффициент;
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЕсли;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Результат;
КонецФункции

Функция ПолучитьБазовуюЕдиницуНоменклатуры(Номенклатура) Экспорт
	Попытка
		ОбъектНоменклатуры = Номенклатура.ПолучитьОбъект();
		МетаНоменклатуры = ОбъектНоменклатуры.Метаданные();
		Имена = Новый Массив;
		Имена.Добавить("ЕдиницаИзмерения");
		Имена.Добавить("БазоваяЕдиницаИзмерения");
		Имена.Добавить("ЕдиницаХранения");
		Имена.Добавить("ЕдиницаДляОтчетов");
		ИмяЕдиницы = НайтиИмяРеквизитаПоИменам(МетаНоменклатуры, Имена);
		Если ИмяЕдиницы = "" Тогда
			Ключи = Новый Массив;
			Ключи.Добавить("единиц");
			ИмяЕдиницы = НайтиИмяРеквизитаПоКлючам(МетаНоменклатуры, Ключи);
		КонецЕсли;
		Если ИмяЕдиницы <> "" Тогда
			ЗначениеЕдиницы = ОбъектНоменклатуры[ИмяЕдиницы];
			Если ЗначениеЗаполнено(ЗначениеЕдиницы) Тогда
				Возврат ЗначениеЕдиницы;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Процедура УстановитьНулевуюРучнуюСкидку(СтрокаЗапаса, МетаСтроки) Экспорт
	Для Каждого МетаРеквизит Из МетаСтроки.Реквизиты Цикл
		ТекстРеквизита = НРег(
			МетаРеквизит.Имя + " " + Строка(МетаРеквизит.Синоним));
		Если Найти(ТекстРеквизита, "скидк") > 0
			И (Найти(ТекстРеквизита, "ручн") > 0
				Или Найти(ТекстРеквизита, "процент") > 0) Тогда
			Попытка
				СтрокаЗапаса[МетаРеквизит.Имя] = 0;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьЕдиницуКоличествоИЦену(
	СтрокаЗапаса,
	МетаСтроки,
	Номенклатура,
	Позиция) Экспорт

	ИменаЕдиницы = Новый Массив;
	ИменаЕдиницы.Добавить("ЕдиницаИзмерения");
	ИменаЕдиницы.Добавить("Единица");
	ИмяПоляЕдиницы = НайтиИмяРеквизитаПоИменам(
		МетаСтроки, ИменаЕдиницы);
	Если ИмяПоляЕдиницы = "" Тогда
		КлючиЕдиницы = Новый Массив;
		КлючиЕдиницы.Добавить("единиц");
		ИмяПоляЕдиницы = НайтиИмяРеквизитаПоКлючам(
			МетаСтроки, КлючиЕдиницы);
	КонецЕсли;

	ИменаКоэффициента = Новый Массив;
	ИменаКоэффициента.Добавить("Коэффициент");
	ИменаКоэффициента.Добавить("Кратность");
	ИмяПоляКоэффициента = НайтиИмяРеквизитаПоИменам(
		МетаСтроки, ИменаКоэффициента);

	ЗначениеКодаЕдиницы = Неопределено;
	ЗначениеМножителя = Неопределено;
	КодЕдиницы = "piece";
	Если Позиция.Свойство("unit", ЗначениеКодаЕдиницы) Тогда
		КодЕдиницы = СокрЛП(Строка(ЗначениеКодаЕдиницы));
	КонецЕсли;

	Множитель = 1;
	Если Позиция.Свойство("multiplier", ЗначениеМножителя) Тогда
		Если Число(ЗначениеМножителя) > 0 Тогда
			Множитель = Число(ЗначениеМножителя);
		КонецЕсли;
	КонецЕсли;

	Количество = Число(Позиция.quantity);
	Цена = Число(Позиция.price);
	НайденнаяЕдиница = ПолучитьЕдиницуИзПрошлыхЗаказов(
		Номенклатура,
		КодЕдиницы,
		ИмяПоляЕдиницы,
		ИмяПоляКоэффициента);

	Если НайденнаяЕдиница.Найдена Тогда
		Если ИмяПоляЕдиницы <> "" Тогда
			СтрокаЗапаса[ИмяПоляЕдиницы] = НайденнаяЕдиница.Единица;
		КонецЕсли;
		Если ИмяПоляКоэффициента <> "" Тогда
			СтрокаЗапаса[ИмяПоляКоэффициента] =
				НайденнаяЕдиница.Коэффициент;
		КонецЕсли;
	Иначе
		БазоваяЕдиница = ПолучитьБазовуюЕдиницуНоменклатуры(Номенклатура);
		Если БазоваяЕдиница <> Неопределено
			И ИмяПоляЕдиницы <> "" Тогда
			СтрокаЗапаса[ИмяПоляЕдиницы] = БазоваяЕдиница;
		КонецЕсли;
		Если ИмяПоляКоэффициента <> "" Тогда
			СтрокаЗапаса[ИмяПоляКоэффициента] = 1;
		КонецЕсли;

		Если КодЕдиницы <> "piece" И Множитель > 1 Тогда
			Количество = Количество * Множитель;
			Цена = Цена / Множитель;
		КонецЕсли;
	КонецЕсли;

	СтрокаЗапаса.Количество = Количество;
	СтрокаЗапаса.Цена = Цена;
	СтрокаЗапаса.Сумма = Количество * Цена;
	СтрокаЗапаса.Всего = СтрокаЗапаса.Сумма;
	УстановитьНулевуюРучнуюСкидку(СтрокаЗапаса, МетаСтроки);
КонецПроцедуры

Процедура УстановитьДатуОтгрузки(
	Заказ,
	СтрокаЗапаса,
	МетаСтроки,
	ДатаОтгрузки) Экспорт

	Если ДатаОтгрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИменаДаты = Новый Массив;
	ИменаДаты.Добавить("ДатаОтгрузки");
	ИменаДаты.Добавить("ДатаДоставки");
	ИмяДатыЗаказа = НайтиИмяРеквизитаПоИменам(
		Заказ.Метаданные(), ИменаДаты);
	Если ИмяДатыЗаказа = "" Тогда
		КлючиДаты = Новый Массив;
		КлючиДаты.Добавить("отгруз");
		ИмяДатыЗаказа = НайтиИмяРеквизитаПоКлючам(
			Заказ.Метаданные(), КлючиДаты);
	КонецЕсли;
	Если ИмяДатыЗаказа <> "" Тогда
		Заказ[ИмяДатыЗаказа] = ДатаОтгрузки;
	КонецЕсли;

	ИмяДатыСтроки = НайтиИмяРеквизитаПоИменам(
		МетаСтроки, ИменаДаты);
	Если ИмяДатыСтроки = "" Тогда
		КлючиДатыСтроки = Новый Массив;
		КлючиДатыСтроки.Добавить("отгруз");
		ИмяДатыСтроки = НайтиИмяРеквизитаПоКлючам(
			МетаСтроки, КлючиДатыСтроки);
	КонецЕсли;
	Если ИмяДатыСтроки <> "" Тогда
		СтрокаЗапаса[ИмяДатыСтроки] = ДатаОтгрузки;
	КонецЕсли;
КонецПроцедуры

Функция НайтиРанееСозданныйЗаказ(Маркер) Экспорт
	// Маркер вида [CLOVER:...] нельзя искать через ПОДОБНО:
	// в серверной базе квадратные скобки могут интерпретироваться
	// как шаблон и вернуть чужой заказ. Проверяем точное вхождение
	// строки уже на стороне 1С.
	Попытка
		ЗапросЗаказа = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		| Заказы.Ссылка КАК Ссылка,
		| Заказы.Комментарий КАК Комментарий
		|ИЗ
		| Документ.ЗаказПокупателя КАК Заказы
		|ГДЕ
		| НЕ Заказы.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		| Заказы.Дата УБЫВ");
		ВыборкаЗаказа = ЗапросЗаказа.Выполнить().Выбрать();
		Пока ВыборкаЗаказа.Следующий() Цикл
			Если Найти(Строка(ВыборкаЗаказа.Комментарий), Маркер) > 0 Тогда
				Возврат ВыборкаЗаказа.Ссылка.ПолучитьОбъект();
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Процедура ПодтвердитьЗаказВClover(
	Соединение,
	ИдентификаторЗаказа,
	НомерЗаказаClover,
	НомерДокумента) Экспорт

	ДанныеПодтверждения = Новый Структура;
	ДанныеПодтверждения.Вставить("orderNumber", НомерЗаказаClover);
	ДанныеПодтверждения.Вставить("documentNumber", НомерДокумента);
	ЗаписьПодтверждения = Новый ЗаписьJSON;
	ЗаписьПодтверждения.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьПодтверждения, ДанныеПодтверждения);
	ТелоПодтверждения = ЗаписьПодтверждения.Закрыть();

	ЗапросПодтверждения = Новый HTTPЗапрос(
		"/api/one-c/orders/"
		+ Строка(ИдентификаторЗаказа)
		+ "/ack");
	ЗапросПодтверждения.Заголовки.Вставить(
		"Content-Type", "application/json; charset=utf-8");
	ДобавитьЗаголовкиОбмена(ЗапросПодтверждения);
	ЗапросПодтверждения.УстановитьТелоИзСтроки(
		ТелоПодтверждения, КодировкаТекста.UTF8);
	ОтветПодтверждения =
		Соединение.ОтправитьДляОбработки(ЗапросПодтверждения);
	Если ОтветПодтверждения.КодСостояния <> 200 Тогда
		ВызватьИсключение
			"Заказ создан, но Clover не подтвердил получение. HTTP "
			+ Строка(ОтветПодтверждения.КодСостояния)
			+ ": " + ОтветПодтверждения.ПолучитьТелоКакСтроку();
	КонецЕсли;
КонецПроцедуры

Функция СоздатьТестовыйЗаказ() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Номер", "");
	Результат.Вставить("Ошибка", "");

	ЗначениеДаты = Неопределено;
	ЗначениеАдреса = Неопределено;
	ЗначениеТелефона = Неопределено;
	ЗначениеКонтакта = Неопределено;
	ЗначениеКомментария = Неопределено;

	РезультатЦен = ОбновитьЗакупочныеЦеныСледующегоЗаказа();
	Если Не РезультатЦен.Успех Тогда
		Результат.Ошибка = РезультатЦен.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение("192.168.1.47", 4100);
		ЗапросHTTP = Новый HTTPЗапрос("/api/one-c/test-order");
		ДобавитьЗаголовкиОбмена(ЗапросHTTP);
		Ответ = Соединение.Получить(ЗапросHTTP);
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();

		Если Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение
				"Clover вернул HTTP-код "
				+ Строка(Ответ.КодСостояния)
				+ ": " + ТекстОтвета;
		КонецЕсли;

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		ДанныеЗаказа = ДанныеОтвета.order;

		Маркер = "[CLOVER:" + Строка(ДанныеЗаказа.id) + "]";
		Заказ = НайтиРанееСозданныйЗаказ(Маркер);

		Если Заказ = Неопределено Тогда
			ЗаказОбразец = ПолучитьЗаказОбразец();
			Если ЗаказОбразец = Неопределено Тогда
				ВызватьИсключение
					"Не найден рабочий заказ-образец №3266. "
					+ "Он нужен для безопасного заполнения состояния, "
					+ "организации, склада, валюты и НДС.";
			КонецЕсли;

			Заказ = Документы.ЗаказПокупателя.СоздатьДокумент();
			Заказ.ВидОперации =
				Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
			Заказ.Дата = ТекущаяДата();
			ЗаполнитьШапкуПоОбразцу(Заказ, ЗаказОбразец);

			Контрагент = НайтиКонтрагентаПоДанным(ДанныеЗаказа.customer);
			Если Контрагент.Пустая() Тогда
				ВызватьИсключение
					"Контрагент не найден: "
					+ Строка(ДанныеЗаказа.customer.name);
			КонецЕсли;
			Заказ.Контрагент = Контрагент;

			ИменаДоговора = Новый Массив;
			ИменаДоговора.Добавить("Договор");
			ИменаДоговора.Добавить("ДоговорКонтрагента");
			ИмяДоговора = НайтиИмяРеквизитаПоИменам(
				Заказ.Метаданные(), ИменаДоговора);
			Если ИмяДоговора = "" Тогда
				КлючиДоговора = Новый Массив;
				КлючиДоговора.Добавить("договор");
				ИмяДоговора = НайтиИмяРеквизитаПоКлючам(
					Заказ.Метаданные(), КлючиДоговора);
			КонецЕсли;
			Если ИмяДоговора = "" Тогда
				ВызватьИсключение "В заказе 1С не найден реквизит договора.";
			КонецЕсли;

			МетаДоговора = Заказ.Метаданные().Реквизиты.Найти(ИмяДоговора);
			Договор = НайтиОсновнойДоговор(Контрагент, МетаДоговора);
			Если Договор = Неопределено Тогда
				ВызватьИсключение
					"Для покупателя " + Строка(Контрагент)
					+ " не найден договор с наименованием «Основной договор».";
			КонецЕсли;
			Заказ[ИмяДоговора] = Договор;

			ДатаОтгрузки = Неопределено;
			Если ДанныеЗаказа.Свойство("deliveryDate", ЗначениеДаты) Тогда
				ДатаОтгрузки = ПреобразоватьДатуClover(ЗначениеДаты);
			КонецЕсли;
			Если ДатаОтгрузки = Неопределено Тогда
				ВызватьИсключение
					"В заказе Clover не указана корректная дата доставки.";
			КонецЕсли;

			АдресДоставки = "";
			Если ДанныеЗаказа.Свойство("address", ЗначениеАдреса) Тогда
				АдресДоставки = СокрЛП(Строка(ЗначениеАдреса));
			КонецЕсли;
			ИменаАдреса = Новый Массив;
			ИменаАдреса.Добавить("АдресДоставки");
			ИменаАдреса.Добавить("Адрес");
			ИмяАдреса = НайтиИмяРеквизитаПоИменам(
				Заказ.Метаданные(), ИменаАдреса);
			Если ИмяАдреса <> "" И АдресДоставки <> "" Тогда
				Попытка
					Заказ[ИмяАдреса] = АдресДоставки;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Если Заказ.Метаданные().Реквизиты.Найти("КонтактныйТелефон") <> Неопределено
				И ДанныеЗаказа.customer.Свойство("phone", ЗначениеТелефона) Тогда
				Попытка
					Заказ.КонтактныйТелефон = Строка(ЗначениеТелефона);
				Исключение
				КонецПопытки;
			КонецЕсли;

			Если Заказ.Метаданные().Реквизиты.Найти("КонтактноеЛицо") <> Неопределено
				И ДанныеЗаказа.customer.Свойство("contactName", ЗначениеКонтакта)
				И СокрЛП(Строка(ЗначениеКонтакта)) <> "" Тогда
				Попытка
					МетаКонтакта = Заказ.Метаданные().Реквизиты.Найти("КонтактноеЛицо");
					Если Найти(НРег(Строка(МетаКонтакта.Тип)), "строка") > 0 Тогда
						Заказ.КонтактноеЛицо = Строка(ЗначениеКонтакта);
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Комментарий =
				"Заказ Clover № " + Строка(ДанныеЗаказа.number)
				+ " " + Маркер;
			Если АдресДоставки <> "" Тогда
				Комментарий = Комментарий
					+ Символы.ПС + "Адрес доставки: " + АдресДоставки;
			КонецЕсли;
			Если ДанныеЗаказа.Свойство("clientComment", ЗначениеКомментария)
				И СокрЛП(Строка(ЗначениеКомментария)) <> "" Тогда
				Комментарий = Комментарий
					+ Символы.ПС + "Комментарий клиента: "
					+ Строка(ЗначениеКомментария);
			КонецЕсли;
			Заказ.Комментарий = Комментарий;

			МетаСтроки = Заказ.Метаданные().ТабличныеЧасти.Найти("Запасы");
			Если МетаСтроки = Неопределено Тогда
				ВызватьИсключение "В заказе 1С не найдена табличная часть Запасы.";
			КонецЕсли;

			СтрокаОбразца = Неопределено;
			Если ЗаказОбразец.Запасы.Количество() > 0 Тогда
				СтрокаОбразца = ЗаказОбразец.Запасы[0];
			КонецЕсли;

			Для Каждого Позиция Из ДанныеЗаказа.items Цикл
				Номенклатура = НайтиНоменклатуруДляОбмена(
					Позиция.id, Позиция.code);
				Если Номенклатура.Пустая() Тогда
					ВызватьИсключение
						"Не найдена номенклатура с кодом "
						+ Строка(Позиция.code);
				КонецЕсли;

				СтрокаЗапаса = Заказ.Запасы.Добавить();
				Если СтрокаОбразца <> Неопределено Тогда
					КопироватьРеквизитСтрокиЕслиЕсть(
						СтрокаЗапаса, СтрокаОбразца, МетаСтроки, "Склад");
					КопироватьРеквизитСтрокиЕслиЕсть(
						СтрокаЗапаса, СтрокаОбразца, МетаСтроки, "СтавкаНДС");
					КопироватьРеквизитСтрокиЕслиЕсть(
						СтрокаЗапаса, СтрокаОбразца, МетаСтроки, "НалогообложениеНДС");
				КонецЕсли;

				СтрокаЗапаса.Номенклатура = Номенклатура;
				ЗаполнитьЕдиницуКоличествоИЦену(
					СтрокаЗапаса, МетаСтроки, Номенклатура, Позиция);
				УстановитьДатуОтгрузки(
					Заказ, СтрокаЗапаса, МетаСтроки, ДатаОтгрузки);

				ИмяСуммыНДС = "";
				ИменаСуммыНДС = Новый Массив;
				ИменаСуммыНДС.Добавить("СуммаНДС");
				ИмяСуммыНДС = НайтиИмяРеквизитаПоИменам(
					МетаСтроки, ИменаСуммыНДС);
				Если ИмяСуммыНДС <> "" Тогда
					Попытка
						СтрокаЗапаса[ИмяСуммыНДС] = 0;
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;

			ИменаСостояния = Новый Массив;
			ИменаСостояния.Добавить("Состояние");
			ИменаСостояния.Добавить("СостояниеЗаказа");
			ИмяСостояния = НайтиИмяРеквизитаПоИменам(
				Заказ.Метаданные(), ИменаСостояния);
			Если ИмяСостояния = ""
				Или Не ЗначениеЗаполнено(Заказ[ИмяСостояния]) Тогда
				ВызватьИсключение
					"Не удалось заполнить состояние заказа по образцу №3266.";
			КонецЕсли;

			Заказ.Записать();
		КонецЕсли;

		// Перед ACK убеждаемся, что номер относится именно к документу
		// с маркером текущего заказа Clover.
		Если Найти(Строка(Заказ.Комментарий), Маркер) = 0 Тогда
			ВызватьИсключение
				"Защита Clover: документ 1С не содержит маркер текущего заказа. "
				+ "Подтверждение не отправлено.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Заказ.Номер) Тогда
			ВызватьИсключение
				"Защита Clover: 1С не присвоила номер новому документу. "
				+ "Подтверждение не отправлено.";
		КонецЕсли;

		ПодтвердитьЗаказВClover(
			Соединение,
			ДанныеЗаказа.id,
			ДанныеЗаказа.number,
			Заказ.Номер);
		Результат.Успех = Истина;
		Результат.Номер = Заказ.Номер;

	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции
