Процедура ДобавитьЗаголовкиОбмена(ЗапросHTTP) Экспорт
	КлючОбмена = ПолучитьКлючОбмена();
	ЗапросHTTP.Заголовки.Вставить("X-Clover-Key", КлючОбмена);
	ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + КлючОбмена);
	ЗапросHTTP.Заголовки.Вставить("X-Clover-Database", "TEST");
	ЗапросHTTP.Заголовки.Вставить("X-Clover-Protocol", "2");
