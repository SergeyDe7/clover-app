# Clover Server — пример для датацентра БЕЗ домена
# Скопируйте в server/.env и замените значения.
# Не коммитьте реальный server/.env.

PORT=4100

# Публичные URL по внутреннему IP сервера (пример)
APP_PUBLIC_URL=http://10.0.0.10:5273
CLOVER_PUBLIC_URL=http://10.0.0.10:5273
ALLOW_DEV_AUTH_LINKS=false

# JWT — длинный случайный секрет
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET

# 1С: исходящие вызовы (если используются)
ONEC_BASE_URL=http://10.0.0.20/your_test_base
ONEC_USERNAME=CloverExchange
ONEC_PASSWORD=CHANGE_ME

# Входящий ключ обмена (обязателен на сервере)
ONEC_API_KEY=CHANGE_ME_TO_AT_LEAST_24_CHARS
ONEC_ALLOW_LOCAL_WITHOUT_KEY=false
ONEC_WRITE_ENABLED=false

# Почта — можно оставить пустым до настройки SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Clover <clover-order@mail.ru>
MANAGER_NOTIFICATION_EMAIL=clover-order@mail.ru

# Telegram — опционально
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# Web Push / Passkey — полноценно после домена+HTTPS (см. AFTER_DOMAIN.md)
VAPID_SUBJECT=mailto:admin@example.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PASSKEY_RP_NAME=Clover
PASSKEY_RP_ID=10.0.0.10
PASSKEY_ORIGIN=http://10.0.0.10:5273
CBOR_NATIVE_ACCELERATION_DISABLED=true
