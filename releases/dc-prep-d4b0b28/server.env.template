# Clover Server — шаблон для ДЦ (этап 1: LAN / без HTTPS)
# Скопировать в server\.env на СЕРВЕРЕ. Не коммитить реальный .env.
# Подставить значения вместо CHANGE_ME / 10.0.0.10.

PORT=4100
HOST=0.0.0.0

# --- Этап 1: внутренний IP сервера Clover ---
APP_PUBLIC_URL=http://10.0.0.10:5273
CLOVER_PUBLIC_URL=http://10.0.0.10:5273
ALLOW_DEV_AUTH_LINKS=false

JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET

# 1С TEST (не production)
ONEC_BASE_URL=http://10.0.0.20/your_test_base
ONEC_USERNAME=CloverExchange
ONEC_PASSWORD=CHANGE_ME
ONEC_API_KEY=CHANGE_ME_TO_AT_LEAST_24_CHARS
ONEC_ALLOW_LOCAL_WITHOUT_KEY=false
ONEC_WRITE_ENABLED=false

# Почта — по желанию на этапе 1
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Clover <clover-order@mail.ru>
MANAGER_NOTIFICATION_EMAIL=clover-order@mail.ru

TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# Passkey на этапе 1 (IP). После HTTPS — заменить на домен.
PASSKEY_RP_NAME=Clover
PASSKEY_RP_ID=10.0.0.10
PASSKEY_ORIGIN=http://10.0.0.10:5273
CBOR_NATIVE_ACCELERATION_DISABLED=true

# Web Push — пусто до этапа 2 (домен + HTTPS)
VAPID_SUBJECT=mailto:admin@clover-order.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# =============================================================================
# Этап 2 (НЕ включать, пока нет рабочего HTTPS на clover-order.ru):
# APP_PUBLIC_URL=https://clover-order.ru
# CLOVER_PUBLIC_URL=https://clover-order.ru
# PASSKEY_RP_ID=clover-order.ru
# PASSKEY_ORIGIN=https://clover-order.ru
# + сгенерировать VAPID: npx --yes web-push generate-vapid-keys
# См. docs/deploy/AFTER_DOMAIN.md и docs/deploy/PUSH_ENABLE.md
# =============================================================================
