# Clover Server — .env для ДЦ, этап 1 (LAN / TEST)
# Скопировать в: /opt/clover/clover-app/server/.env
# chmod 600. Не коммитить.
#
# Пометки:
#   【АНДРЕЙ】 — подставить на сервере
#   (ФИКС)    — не менять без согласования с заказчиком

PORT=4100
HOST=0.0.0.0

# 【АНДРЕЙ: внутренний IP VM】 — заменить все вхождения YOUR_LAN_IP
APP_PUBLIC_URL=http://YOUR_LAN_IP:5273
CLOVER_PUBLIC_URL=http://YOUR_LAN_IP:5273
ALLOW_DEV_AUTH_LINKS=false

# 【АНДРЕЙ】 openssl rand -hex 32
JWT_SECRET=PASTE_JWT_SECRET_HERE

# --- 1С TEST ---
# 【АНДРЕЙ】 если исходящий Clover→1С нужен на этапе 1 — заполнить URL/пароль.
# Если только pull из 1С — URL можно уточнить позже; ключ всё равно обязателен.
ONEC_BASE_URL=http://YOUR_1C_HOST/YOUR_TEST_BASE
ONEC_USERNAME=CloverExchange
ONEC_PASSWORD=PASTE_ONEC_PASSWORD_OR_LEAVE_AND_FIX_LATER

# 【АНДРЕЙ】 openssl rand -hex 32  (≥24 символов). Тот же ключ → 1С X-Clover-Key
ONEC_API_KEY=PASTE_ONEC_API_KEY_HERE

# (ФИКС)
ONEC_ALLOW_LOCAL_WITHOUT_KEY=false
ONEC_WRITE_ENABLED=false

# Почта — опционально на этапе 1
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Clover <clover-order@mail.ru>
MANAGER_NOTIFICATION_EMAIL=clover-order@mail.ru

TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

PASSKEY_RP_NAME=Clover
PASSKEY_RP_ID=YOUR_LAN_IP
PASSKEY_ORIGIN=http://YOUR_LAN_IP:5273
CBOR_NATIVE_ACCELERATION_DISABLED=true

# Push — только этап 2 (домен HTTPS clover-order.ru). Сейчас пусто.
VAPID_SUBJECT=mailto:admin@clover-order.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Этап 2 (НЕ раскомментировать без «да» заказчика) ===
# APP_PUBLIC_URL=https://clover-order.ru
# CLOVER_PUBLIC_URL=https://clover-order.ru
# PASSKEY_RP_ID=clover-order.ru
# PASSKEY_ORIGIN=https://clover-order.ru
