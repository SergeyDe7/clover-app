{
  "name": "clover-server",
  "version": "4.0.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/run-package-scripts.mjs check",
    "test:onec": "node scripts/run-package-scripts.mjs test:onec",
    "apply:onec-links": "node scripts/apply-onec-links.mjs",
    "test:v18": "node scripts/verify-v18.mjs",
    "test:all": "npm run check && npm run test:onec && npm run test:v18 && npm run test:runtime && npm run test:manager-notifications && npm run test:manager-tabs && npm run test:order-trash",
    "test:runtime": "node scripts/verify-runtime-integrations.mjs",
    "test:manager-notifications": "node scripts/verify-manager-notifications.mjs",
    "test:manager-tabs": "node scripts/verify-manager-tabs-smoke.mjs",
    "test:order-trash": "node scripts/verify-order-trash.mjs",
    "test:push-badge": "node scripts/verify-push-badge.mjs",
    "test:security": "node --test \"tests/security/*.test.mjs\""
  },
  "dependencies": {
    "@simplewebauthn/server": "13.0.0",
    "adm-zip": "0.6.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "nodemailer": "7.0.5",
    "sharp": "^0.35.3",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  }
}
