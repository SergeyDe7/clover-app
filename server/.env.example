# Clover Server 4.0.4 — пример настроек подключения к 1С
# Скопируйте этот файл в server/.env только после публикации HTTP-сервиса 1С.

# Полный адрес опубликованной базы без пути /hs/clover/...
# Пример HTTPS: https://1c.internal.example
# Пример HTTP к частному литералу: http://192.168.1.20/cloverbase
# Для HTTP обязателен серверный флаг ONEC_ALLOW_INSECURE_HTTP=true
ONEC_BASE_URL=
ONEC_ALLOW_INSECURE_HTTP=false

# Отдельный пользователь 1С с минимальными правами.
ONEC_USERNAME=CloverExchange
ONEC_PASSWORD=

# --- Inbound 1C → Clover (SEC-001: credential ↔ contour binding) ---
# Separate exchange credentials. Requested database never chooses authority.
# ≥24 chars, not a placeholder. Contours that share keys are rejected.
# Provide a key only for each contour listed in ONEC_ALLOWED_DATABASES.
# TEST is optional: set ONEC_TEST_EXCHANGE_API_KEY only when TEST is allowlisted.
ONEC_TEST_EXCHANGE_API_KEY=
ONEC_VLAVKA_EXCHANGE_API_KEY=
# Optional single-contour legacy inbound ONLY (OFF by default). Never multi-contour.
# ONEC_LEGACY_INBOUND_KEY_CONTOUR=TEST
# Local bypass: TEST-only + loopback + non-prod. Never VLAVKA / never multi-contour.
# Для локальной разработки без ключа: ONEC_ALLOW_LOCAL_WITHOUT_KEY=true
ONEC_ALLOW_LOCAL_WITHOUT_KEY=false

# --- Outbound Clover → 1C (draft/health) ---
# NOT used for inbound /api/one-c/* multi-contour authentication.
# Login/password or this key for outbound HTTP to 1C only.
ONEC_API_KEY=

# Фоновый возврат истёкших claim (sending → ready) без ожидания следующего pull.
# По умолчанию 30000 мс. Минимум в коде: 5000.
# ONEC_CLAIM_REQUEUE_INTERVAL_MS=30000

# Полный сброс серверных данных (POST /api/admin/reset + confirm: RESET).
# Пусто = только loopback / localhost. false = запрет. true = явно разрешено (удалённый TEST).
# ALLOW_ADMIN_FULL_RESET=false

# Реальная запись черновиков заблокирована по умолчанию.
# Включать только после резервной копии и проверки чтения справочников.
ONEC_WRITE_ENABLED=false

# --- Prod-контур (рабочая 1С / VLAVKA) ---
# По умолчанию выключен: обмен только с базой TEST.
# Включать только после backup рабочей 1С и явного «да».
ONEC_PROD_EXCHANGE_ENABLED=false
# Список имён баз через запятую. TEST НЕ добавляется автоматически.
# VLAVKA-only example:
#   ONEC_PROD_EXCHANGE_ENABLED=true
#   ONEC_ALLOWED_DATABASES=VLAVKA
#   ONEC_DEFAULT_EXCHANGE_DATABASE=VLAVKA
#   ONEC_VLAVKA_EXCHANGE_API_KEY=...   # required
#   # ONEC_TEST_EXCHANGE_API_KEY not required when TEST is absent from allowlist
# Dual-contour example: ONEC_ALLOWED_DATABASES=TEST,VLAVKA (requires both keys)
ONEC_ALLOWED_DATABASES=TEST
# Куда ставить заказ кнопкой менеджера, если в запросе не указана база.
ONEC_DEFAULT_EXCHANGE_DATABASE=TEST

# Секреты самого Clover. Не публикуйте server/.env в GitHub.
JWT_SECRET=

# Clover V18: public URL used in verification/reset links
APP_PUBLIC_URL=http://localhost:5273
# ЛК path on storefront host (canonical production: https://clover-spb.ru/lk)
CABINET_PATH=/lk
ALLOW_DEV_AUTH_LINKS=true

# Outgoing email (example for your domain mailbox)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Web Push (configure after domain + HTTPS)
VAPID_SUBJECT=mailto:admin@example.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Passkeys / Face ID / fingerprint
PASSKEY_RP_NAME=Clover
# Local development: localhost. Production: your exact domain without protocol.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5273
CBOR_NATIVE_ACCELERATION_DISABLED=true

# Автодополнение карточек при добавлении из 1С (фото + описание из открытых источников).
# true по умолчанию в коде. false — отключить сеть.
PRODUCT_ENRICH_ENABLED=true

# Manager event notifications
# Public URL used in email/Telegram links after domain + HTTPS.
CLOVER_PUBLIC_URL=http://localhost:5273
# Optional fallback email. The address can also be set in Manager Settings.
MANAGER_NOTIFICATION_EMAIL=clover-order@mail.ru
# Telegram bot token is a secret and must stay only in server/.env.
TELEGRAM_BOT_TOKEN=
# Optional fallback Chat ID. It can also be entered in Manager Settings.
TELEGRAM_MANAGER_CHAT_ID=

# --- Stage 8: product batch translation (provider registry) ---
# Server-only. Default: disabled. Runtime registry: disabled | azure.
# Monthly limit applies to Azure configuration only — not a universal free quota.
# Do not put keys in Git or the frontend. Test adapters are never selected via env.
# CLOVER_PRODUCT_TRANSLATION_PROVIDER=disabled
# CLOVER_PRODUCT_TRANSLATION_PROVIDER=azure
# CLOVER_AZURE_TRANSLATOR_KEY=
# CLOVER_AZURE_TRANSLATOR_REGION=global
# CLOVER_PRODUCT_TRANSLATION_MONTHLY_LIMIT=1800000
# Docs: docs/technical/i18n-stage-8-product-batch-translation.md

