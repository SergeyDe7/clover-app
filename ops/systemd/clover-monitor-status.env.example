# Status-only projection for clover-monitor.service.
# Install as /etc/clover/monitor-status.env, owner root:clover-monitor, mode 0640.
# The API process receives CLOVER_MONITOR_STATUS_HMAC_KEY from a secret source.
# The monitor reads the same value from /etc/clover/monitor-status.hmac, owner
# root:clover-monitor, mode 0640. Never place that key in this projection file.
# Never add keys, passwords, tokens, recipients, URLs or customer data.
ONEC_WRITE_ENABLED=false
ONEC_PROD_EXCHANGE_ENABLED=false
ONEC_ALLOWED_DATABASES=TEST
ALLOW_ADMIN_FULL_RESET=false
CLOVER_PRODUCT_TRANSLATION_PROVIDER=disabled
CLOVER_PAUSE_ONEC_CLAIMS=false
CLOVER_PAUSE_REGISTRATION=false
CLOVER_PAUSE_GUEST_ORDERS=false
CLOVER_PAUSE_UPLOADS=false
CLOVER_PAUSE_OUTBOUND_NOTIFICATIONS=false
CLOVER_PAUSE_EMAIL=false
CLOVER_PAUSE_TELEGRAM=false
CLOVER_PAUSE_PUSH=false
