[Unit]
Description=Clover audit retention dry-run timer
# Stage 5: scheduled retention must stay read-only. Apply remains manual-only.

[Timer]
OnCalendar=*-*-01 03:40:00
Persistent=true
AccuracySec=30min
RandomizedDelaySec=20min
Unit=clover-audit-retention-dry-run.service

[Install]
WantedBy=timers.target
